# Copy to .env and fill in every value — none of these have a default baked
# into source (see bootstrap/settings/models.py); the app refuses to start
# without them.

# --- Persistence: which draft-history adapter, and its backing stores.
# DATABASE_URL stores system data (canon scores + auth).
# DRAFT_DATABASE_URL stores only the TIERED backend's cold draft archive.
# Redis is only read for the REDIS/TIERED backends.
#   memory — single process, no external services.
#   redis  — hot tier only (needs Redis, i.e. REDIS_URL).
#   tiered — Redis hot + independent Postgres cold archive (needs both URLs).
DRAFT_HISTORY_BACKEND=
# Run both `alembic upgrade head` and
# `alembic -c alembic-draft.ini upgrade head` for the tiered backend.
DATABASE_URL=
DRAFT_DATABASE_URL=
REDIS_URL=

# --- Google Sign-In: the id_token audience(s) this deployment accepts (JSON array, public).
GOOGLE_CLIENT_IDS=

# --- Access tokens (JWT): issuance and verification. JWT_SECRET must be >= 32 bytes
# or the app refuses to start.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=

# --- Refresh sessions / cookie. SECURE=false only for local http; true in any https deployment.
AUTH_REFRESH_TTL_SECONDS=
AUTH_REFRESH_COOKIE_SECURE=
AUTH_REFRESH_COOKIE_SAMESITE=

# --- HTTP: CORS — origins allowed (JSON array).
CORS_ORIGINS=
